<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd : lance scripts/daily.sh chaque jour à 09:00.
     Installer :
       cp scripts/com.mdecombax.chesscoach.daily.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.mdecombax.chesscoach.daily.plist
     Désinstaller :
       launchctl unload ~/Library/LaunchAgents/com.mdecombax.chesscoach.daily.plist
     Adapte le chemin PROJET ci-dessous si tu déplaces le dossier. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mdecombax.chesscoach.daily</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/martindecombarieu/Documents/Code/Echecs/coachV2/scripts/daily.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <!-- PATH élargi pour trouver python/git/claude/stockfish hors shell interactif -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/martindecombarieu/Documents/Code/Echecs/coachV2/reports/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/martindecombarieu/Documents/Code/Echecs/coachV2/reports/launchd.err.log</string>
</dict>
</plist>
